html, body {
  margin: 0;
  padding: 0;
  background: #07131c;
  color: #edf6ff;
  font-family: Arial, Helvetica, sans-serif;
}

* {
  box-sizing: border-box;
}

button {
  font: inherit;
}

.page-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(34, 102, 170, 0.2), transparent 30%),
    linear-gradient(180deg, #061015 0%, #0d1a25 100%);
  padding: 20px 16px 44px;
}

.app-wrap {
  max-width: 1200px;
  margin: 0 auto;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 10px 0 20px;
}

.eyebrow {
  font-size: 12px;
  letter-spacing: 0.22em;
  color: #7cc1ff;
  margin-bottom: 4px;
}

.topbar h1 {
  margin: 0;
  font-size: clamp(1.8rem, 2vw + 1rem, 3rem);
  letter-spacing: 0.06em;
}

.header-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.header-actions button,
.primary,
.choice-list button,
.control-box button {
  min-height: 44px;
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 12px;
  background: rgba(15, 30, 41, 0.9);
  color: #edf6ff;
  padding: 0 16px;
  cursor: pointer;
}

.header-actions .danger {
  border-color: rgba(255, 104, 104, 0.35);
  color: #ffd0d0;
}

.primary {
  width: 100%;
  font-size: 1.05rem;
  background: linear-gradient(135deg, #0a8ef0, #5ac8ff);
  color: #04131b;
  font-weight: 700;
  border: none;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 22px;
}

.stat-card {
  background: rgba(11, 24, 33, 0.9);
  border: 1px solid rgba(136, 180, 255, 0.12);
  border-radius: 16px;
  padding: 16px 14px;
  min-height: 110px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.stat-card span {
  font-size: 0.72rem;
  color: #9ec9ea;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.stat-card strong {
  font-size: clamp(1.05rem, 0.72vw + 0.9rem, 1.45rem);
  line-height: 1.3;
}

.stat-card.status strong {
  font-size: 0.95rem;
}

.layout {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.8fr);
  gap: 18px;
}

.panel {
  background: rgba(12, 24, 32, 0.84);
  border: 1px solid rgba(140, 178, 224, 0.12);
  border-radius: 20px;
  padding: 18px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 18px;
}

.panel-header h2 {
  margin: 0;
  font-size: clamp(1.05rem, 0.7vw + 0.8rem, 1.5rem);
}

.panel-header span {
  color: #9fd1ff;
  font-size: 0.8rem;
}

.allocation-row {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 12px;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.asset-title-wrap {
  display: flex;
  flex-direction: column;
}

.asset-name {
  font-weight: 700;
}

.asset-subtitle {
  color: #93bddc;
  font-size: 0.8rem;
}

.control-box {
  display: flex;
  align-items: center;
  gap: 10px;
}

.control-box button {
  min-width: 62px;
  padding: 0 10px;
}

.value-box {
  flex: 1;
  min-width: 110px;
  background: rgba(255,255,255,0.03);
  border-radius: 12px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.value-box strong {
  font-size: 1.15rem;
}

.value-box span {
  color: #a7cadf;
  font-size: 0.75rem;
}

.cta-row {
  margin-top: 20px;
}

.side-stack {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.event-year {
  background: rgba(31, 91, 160, 0.2);
  display: inline-block;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  margin-bottom: 10px;
}

.event-card h3 {
  margin: 0 0 8px;
  font-size: 1.7rem;
}

.event-card p {
  color: #d6eaf8;
  margin: 0 0 14px;
}

.mini-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.badge {
  background: rgba(119, 179, 255, 0.15);
  border: 1px solid rgba(125, 198, 255, 0.25);
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.68rem;
}

.history-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.history-list li {
  display: grid;
  grid-template-columns: 56px 1fr auto;
  gap: 10px;
  align-items: center;
  background: rgba(255,255,255,0.02);
  border-radius: 12px;
  padding: 10px 12px;
  color: #d8ebff;
}

.history-list strong {
  color: #b0d7ff;
}

.history-list span {
  font-size: 0.88rem;
}

.history-list em {
  font-style: normal;
  color: #9ef4d4;
  font-size: 0.72rem;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(4, 11, 17, 0.8);
  display: grid;
  place-items: center;
  padding: 20px;
}

.modal-card,
.report-card {
  width: min(820px, 100%);
  background: linear-gradient(180deg, rgba(9, 23, 31, 0.98), rgba(13, 29, 41, 0.98));
  border: 1px solid rgba(135, 185, 255, 0.25);
  border-radius: 22px;
  box-shadow: 0 28px 80px rgba(0,0,0,0.4);
  padding: 24px;
}

.modal-card h2,
.report-card h2 {
  margin: 0 0 12px;
  font-size: clamp(1.4rem, 2vw, 2.2rem);
}

.modal-card p,
.report-card p {
  margin: 0 0 16px;
  color: #d7eaf9;
}

.modal-amount {
  margin-bottom: 16px;
  background: rgba(74, 157, 255, 0.12);
  border: 1px solid rgba(135, 196, 255, 0.2);
  padding: 14px 16px;
  border-radius: 12px;
  font-weight: 700;
}

.choice-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.choice-list button {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 82px;
  text-align: left;
  gap: 4px;
  padding: 14px 16px;
}

.choice-list span {
  font-weight: 700;
}

.choice-list small {
  color: #b6d4eb;
}

.report-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.report-grid > div {
  background: rgba(255,255,255,0.02);
  border-radius: 14px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.report-grid span {
  color: #a9d1ef;
  font-size: 0.7rem;
  text-transform: uppercase;
}

.report-grid strong {
  font-size: 1.2rem;
}

@media (max-width: 900px) {
  .stats-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .page-shell {
    padding-left: 12px;
    padding-right: 12px;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .stats-row {
    grid-template-columns: 1fr;
  }

  .allocation-row {
    grid-template-columns: 1fr;
  }

  .control-box {
    flex-wrap: wrap;
  }

  .choice-list {
    grid-template-columns: 1fr;
  }

  .report-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
